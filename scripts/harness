#!/usr/bin/env bash
# ============================================================
# Team Harness CLI — v2.0
# ============================================================
# 统一入口，所有 Harness 操作通过此脚本执行。
#
# 用法: ./scripts/harness <command> [options]
# 运行 ./scripts/harness --help 查看所有命令
# ============================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# ---- Python bootstrap ----
find_python() {
  for py in python3 python; do
    if command -v "$py" &>/dev/null; then
      echo "$py"
      return
    fi
  done
  echo ""
}

PYTHON="$(find_python)"
if [ -z "$PYTHON" ]; then
  echo "Error: Python 3 is required. Install via 'brew install python3' or your package manager."
  exit 1
fi

# Check Python 3
if ! "$PYTHON" -c "import sys; sys.exit(0 if sys.version_info >= (3, 7) else 1)" 2>/dev/null; then
  echo "Error: Python 3.7+ is required. Current: $("$PYTHON" --version 2>&1)"
  exit 1
fi

# Bootstrap venv and install dependencies
VENV_DIR="$SCRIPT_DIR/.harness_venv"
if [ ! -f "$VENV_DIR/bin/activate" ]; then
  "$PYTHON" -m venv "$VENV_DIR" 2>/dev/null || {
    echo "Error: Failed to create virtual environment. Ensure python3-venv is installed."
    exit 1
  }
fi

# Install pyyaml if not present
if ! "$VENV_DIR/bin/pip" show pyyaml >/dev/null 2>&1; then
  "$VENV_DIR/bin/pip" install --quiet pyyaml 2>/dev/null || true
fi

# Run harness — add scripts/ to Python path
# 注意: ${PYTHONPATH:+:$PYTHONPATH} 避免在 set -u 且 PYTHONPATH 未定义时崩溃
export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$VENV_DIR/bin/python" -m harness_py "$@"

#!/bin/bash
# HARNESS_HOOK_VERSION=2.0.0
# pre-commit - 提交前编译检查（Maven）
# 只检查不修改代码
# 安装方式：由 scripts/install-git-hooks.sh 自动安装到 .git/hooks/pre-commit

set -e

# ====== 颜色输出 ======
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}[pre-commit] 开始编译检查...${NC}"

# ====== 检测 Maven 构建文件 ======
if [ ! -f "pom.xml" ]; then
    echo -e "${YELLOW}[pre-commit] 未检测到 pom.xml，跳过检查${NC}"
    exit 0
fi

# ====== 获取暂存区改动的 Java 文件 ======
STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.java$' || true)

if [ -z "$STAGED_JAVA_FILES" ]; then
    echo -e "${GREEN}[pre-commit] 没有改动的 Java 文件，跳过检查${NC}"
    exit 0
fi

echo -e "${YELLOW}[pre-commit] 检测到改动的 Java 文件：${NC}"
echo "$STAGED_JAVA_FILES" | sed 's/^/  /'

# ====== 执行编译检查 ======
COMPILE_EXIT_CODE=0

# 优先使用 mvnw
if [ -f "./mvnw" ]; then
    MVN_CMD="./mvnw"
else
    MVN_CMD="mvn"
fi

echo -e "${YELLOW}[pre-commit] 执行 Maven 编译检查...${NC}"
$MVN_CMD compile -q -DskipTests 2>&1 || COMPILE_EXIT_CODE=$?

# ====== 输出结果 ======
if [ $COMPILE_EXIT_CODE -ne 0 ]; then
    echo ""
    echo -e "${RED}[pre-commit] 编译未通过！请修复上述问题后重新提交。${NC}"
    echo -e "${YELLOW}[pre-commit] 如需跳过检查（不推荐），使用: git commit --no-verify${NC}"
    exit 1
else
    echo -e "${GREEN}[pre-commit] 编译通过 ✓${NC}"
    exit 0
fi

#!/bin/bash
# pre-push - 推送前增量单测覆盖率检查（JaCoCo + diff-cover）
# 校验本次推送相对 origin/main 的增量行覆盖率 > 80%
# 安装方式：由 scripts/install-git-hooks.sh 自动安装到 .git/hooks/pre-push

set -euo pipefail

# ====== 颜色输出 ======
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}[pre-push] 增量覆盖率检查...${NC}"

# ====== 非 Maven 项目跳过 ======
if [ ! -f "pom.xml" ]; then
  echo -e "${YELLOW}[pre-push] 未检测到 pom.xml，跳过${NC}"
  exit 0
fi

# ====== 检查 diff-cover 是否安装（未装则提示并跳过，不阻塞）======
if ! command -v diff-cover &>/dev/null; then
  echo -e "${YELLOW}[pre-push] 未安装 diff-cover，跳过覆盖率校验${NC}"
  echo -e "${YELLOW}[pre-push]   安装: pip install diff-cover${NC}"
  exit 0
fi

# ====== 确定基线分支（origin/main）======
BASE="origin/main"
if ! git rev-parse --verify "$BASE" &>/dev/null; then
  echo -e "${YELLOW}[pre-push] 基线 ${BASE} 不存在（未 git fetch？），跳过覆盖率校验${NC}"
  exit 0
fi

# ====== 选择 mvn ======
if [ -f "./mvnw" ]; then
  MVN_CMD="./mvnw"
else
  MVN_CMD="mvn"
fi

# ====== 跑测试（强制不跳过，产出 JaCoCo 报表）======
echo -e "${YELLOW}[pre-push] 运行测试（mvn test + JaCoCo）...${NC}"
if ! $MVN_CMD -q -DskipTests=false test jacoco:report 2>&1 | tail -30; then
  echo -e "${RED}[pre-push] 测试失败，推送中止${NC}"
  exit 1
fi

# ====== diff-cover 卡增量行覆盖率 > 80% ======
JACOCO_XML="target/site/jacoco/jacoco.xml"
if [ ! -f "$JACOCO_XML" ]; then
  echo -e "${RED}[pre-push] 未找到 ${JACOCO_XML}${NC}"
  echo -e "${YELLOW}[pre-push] 请确认 pom 已配置 jacoco-maven-plugin（prepare-agent + report）${NC}"
  exit 1
fi

echo -e "${YELLOW}[pre-push] 校验增量行覆盖率（> 80%）...${NC}"
if ! diff-cover "$JACOCO_XML" --compare-branch="$BASE" --fail-under=80; then
  echo ""
  echo -e "${RED}[pre-push] 增量覆盖率未达 80%，推送中止${NC}"
  echo -e "${YELLOW}[pre-push] 如需跳过（不推荐）: git push --no-verify${NC}"
  exit 1
fi

echo -e "${GREEN}[pre-push] 增量覆盖率通过 ✓${NC}"
exit 0

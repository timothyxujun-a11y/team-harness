{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/timothyxujun-a11y/team-harness/schemas/harness-profile.schema.json",
  "title": "Harness Profile Definition",
  "description": "Profile 定义文件 (profile.yaml)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "compatibility", "content"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "harness.company.io/v1"
    },
    "kind": {
      "type": "string",
      "const": "HarnessProfile"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Profile 名称（小写 + 连字符）"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Profile 版本（语义化版本）"
        },
        "description": { "type": "string" }
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["languages", "buildTools"],
      "properties": {
        "languages": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "javaVersions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "支持的 Java 版本列表"
        },
        "buildTools": {
          "type": "array",
          "items": { "type": "string", "enum": ["maven"] },
          "minItems": 1
        }
      }
    },
    "dependsOn": {
      "type": "array",
      "items": { "type": "string" },
      "description": "依赖的其他 Profile"
    },
    "conflictsWith": {
      "type": "array",
      "items": { "type": "string" },
      "description": "冲突的 Profile"
    },
    "content": {
      "type": "object",
      "required": ["index", "rules", "ruleDirectory"],
      "properties": {
        "index": { "type": "string", "description": "索引文件路径" },
        "rules": { "type": "string", "description": "规则定义文件路径" },
        "ruleDirectory": { "type": "string", "description": "规则文件目录" }
      }
    }
  }
}

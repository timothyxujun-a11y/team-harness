{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/timothyxujun-a11y/team-harness/schemas/harness-rules.schema.json",
  "title": "Harness Rules Definition",
  "description": "规则定义文件 (rules.yaml)",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": { "$ref": "#/definitions/Rule" }
    }
  },
  "definitions": {
    "Rule": {
      "type": "object",
      "required": ["id", "title", "severity", "selectors", "content", "context"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+-[A-Z]+-\\d+$",
          "description": "规则 ID（如 HTTP-ARCH-001）"
        },
        "title": { "type": "string", "description": "规则标题" },
        "description": { "type": "string", "description": "规则说明" },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "info"],
          "description": "严重级别"
        },
        "enforced": {
          "type": "boolean",
          "default": false,
          "description": "是否为不可降级规则"
        },
        "selectors": {
          "type": "object",
          "description": "规则选择条件",
          "properties": {
            "profiles": {
              "type": "array",
              "items": { "type": "string" },
              "description": "适用的 Profile"
            },
            "paths": {
              "type": "object",
              "properties": {
                "include": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "匹配的文件路径（glob）"
                },
                "exclude": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "排除的文件路径（glob）"
                }
              }
            },
            "annotations": {
              "type": "array",
              "items": { "type": "string" },
              "description": "匹配的 Java 类注解"
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "requirement-analysis",
                  "feature-development",
                  "bug-fix",
                  "refactor",
                  "test-generation",
                  "code-review",
                  "commit",
                  "database-change",
                  "dependency-change",
                  "configuration-change"
                ]
              },
              "description": "匹配的任务类型"
            },
            "triggers": {
              "type": "array",
              "items": { "type": "string" },
              "description": "匹配的触发条件"
            }
          }
        },
        "checks": {
          "type": "object",
          "properties": {
            "agent": { "type": "boolean", "default": true, "description": "Agent 是否使用" },
            "ci": { "type": "boolean", "default": false, "description": "CI 是否检查" },
            "documentation": { "type": "boolean", "default": true, "description": "是否进入规范文档" }
          }
        },
        "content": {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "description": "详细规则文件路径" }
          }
        },
        "context": {
          "type": "object",
          "required": ["priority", "estimatedTokens"],
          "properties": {
            "priority": {
              "type": "string",
              "enum": ["high", "medium", "low"],
              "description": "上下文选择优先级"
            },
            "estimatedTokens": {
              "type": "integer",
              "minimum": 1,
              "description": "预计 Token 数"
            }
          }
        },
        "deprecated": {
          "type": "boolean",
          "default": false,
          "description": "是否已废弃"
        },
        "replacedBy": {
          "type": "string",
          "description": "替代规则 ID"
        }
      }
    }
  }
}

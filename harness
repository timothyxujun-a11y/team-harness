#!/usr/bin/env bash
# ============================================================
# Team Harness CLI — v1（轻量 AI 工程接入框架，纯 Bash，零依赖）
#
# 用法:
#   ./harness init [选项]        在当前项目接入 Harness
#   ./harness check              本地自检（.ai 完整性 + [CUSTOMIZE] 占位残留）
#   ./harness rules              打印规则路由表 INDEX（按任务选读规则）
#   ./harness log [--init]       查看 / 初始化 AI 操作日志
#   ./harness hooks --install    安装极简 pre-commit（可选；--uninstall 卸载）
#   ./harness version            显示版本信息
#   ./harness help               显示帮助
#
# init 流程（PRD §6.7）:
#   检测项目类型 → 加载 Profile → 生成 .ai 目录 → 生成 CLAUDE.md → 完成接入
# ============================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HARNESS_HOME="$SCRIPT_DIR"
HARNESS_VERSION="$(tr -d '[:space:]' < "$HARNESS_HOME/VERSION" 2>/dev/null || echo "0.0.0")"

# ---- 输出着色（非 TTY 时自动关闭）----
if [[ -t 1 ]]; then
  C_G=$'\033[32m'; C_Y=$'\033[33m'; C_R=$'\033[31m'; C_0=$'\033[0m'
else
  C_G=""; C_Y=""; C_R=""; C_0=""
fi
ok()   { printf '%s✓%s %s\n' "$C_G" "$C_0" "$*"; }
warn() { printf '%s!%s %s\n' "$C_Y" "$C_0" "$*"; }
err()  { printf '%s✗%s %s\n' "$C_R" "$C_0" "$*" >&2; }
say()  { printf '%s\n' "$*"; }

usage() {
  cat <<EOF
Team Harness CLI v${HARNESS_VERSION} — 轻量级 AI 工程接入框架

用法:
  ./harness init [选项]        在当前项目接入 Harness（生成 .ai 与入口文件）
  ./harness check              本地自检（.ai 完整性 + [CUSTOMIZE] 占位残留）
  ./harness rules              打印规则路由表 INDEX（按任务选读规则，不整体加载）
  ./harness log [--init]       查看 / 初始化 AI 操作日志（.ai/log/changes.md）
  ./harness hooks --install    安装极简 pre-commit（可选；--uninstall 卸载）
  ./harness version            显示版本信息
  ./harness help               显示本帮助

init 选项:
  --name <项目名>              项目名称（默认: 当前目录名）
  --profile <profile>          使用的 Profile（默认: 自动检测，MVP 仅 springboot）
  --java-version <版本>        Java 版本（默认: 17）
  --description <描述>         项目一句话描述

接入后产物:
  .ai/
  ├── version.yaml             Harness 版本与 Profile 锁定
  ├── rules/                   规范 + INDEX.md 路由表（编码/API/数据库/异常/安全/测试）
  ├── context/                 项目上下文（人工填写，不被覆盖）
  ├── prompts/                 新需求 / Bug修复 / Review / 单测 / 文档 Prompt 模板
  └── log/changes.md           AI 操作日志（任务结束追加）
  CLAUDE.md                    Claude Code 入口文件
  .claude/skills/              多步骤流程 Skill（new-service / new-api）
EOF
}

# 检测项目类型 → profile（MVP 仅 springboot；未来支持 go/python 时在此分流）
detect_profile() {
  echo "springboot"
}

# 渲染模板：将 {{var}} 占位替换为实际值（sed 选项通过 $@ 传入，文件固定在最后）
render_template() {
  local tpl_file="$1" out_file="$2"; shift 2
  sed "$@" "$HARNESS_HOME/templates/$tpl_file" > "$out_file"
}

cmd_init() {
  local project_name="" profile="" java_version="17" description=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)         project_name="$2"; shift 2 ;;
      --profile)      profile="$2"; shift 2 ;;
      --java-version) java_version="$2"; shift 2 ;;
      --description)  description="$2"; shift 2 ;;
      -h|--help)      usage; return 0 ;;
      *) err "未知参数: $1"; echo; usage; return 1 ;;
    esac
  done

  local project_root
  project_root="$(pwd)"
  [[ -z "$project_name" ]] && project_name="$(basename "$project_root")"
  [[ -z "$profile" ]]      && profile="$(detect_profile)"

  local profile_dir="$HARNESS_HOME/profiles/$profile"
  if [[ ! -d "$profile_dir" ]]; then
    err "Profile 不存在: $profile （查找路径: $profile_dir）"
    return 1
  fi
  if [[ ! -d "$profile_dir/rules" || ! -d "$profile_dir/prompts" ]]; then
    err "Profile 不完整（缺少 rules/ 或 prompts/）: $profile_dir"
    return 1
  fi

  say "Team Harness v${HARNESS_VERSION} — 开始接入"
  say "  项目:    $project_name"
  say "  Profile: $profile"
  say "  Java:    $java_version"
  say ""

  mkdir -p .ai/rules .ai/context .ai/prompts .ai/log

  # rules / prompts：团队规范，跟随 Harness 更新（覆盖）
  cp -R "$profile_dir/rules/."   .ai/rules/   2>/dev/null || true
  cp -R "$profile_dir/prompts/." .ai/prompts/ 2>/dev/null || true
  ok "同步 .ai/rules、.ai/prompts（含 INDEX.md 路由表）"

  # context：项目信息骨架，仅首次创建（不覆盖用户已填写的内容）
  if [[ -d "$profile_dir/context" ]]; then
    local f base
    for f in "$profile_dir"/context/*; do
      [[ -f "$f" ]] || continue
      base="$(basename "$f")"
      [[ -f ".ai/context/$base" ]] || cp "$f" ".ai/context/$base"
    done
  fi
  ok "生成 .ai/context（项目上下文骨架，请人工填写）"

  # log：AI 操作日志骨架，仅首次创建（不覆盖用户记录）
  if [[ -f "$profile_dir/log/changes.md" ]] && [[ ! -f .ai/log/changes.md ]]; then
    cp "$profile_dir/log/changes.md" .ai/log/changes.md
  fi
  ok "生成 .ai/log/changes.md（AI 操作日志，任务结束追加）"

  # skills：多步骤流程 Skill，分发到 .claude/skills/（覆盖同名，团队统一）
  if [[ -d "$profile_dir/skills" ]]; then
    mkdir -p .claude/skills
    local s
    for s in "$profile_dir"/skills/*; do
      [[ -d "$s" ]] || continue
      cp -R "$s" .claude/skills/
    done
    ok "分发 Skill → .claude/skills/（new-service / new-api）"
  fi

  # version.yaml：覆盖（锁定 Harness 版本与 profile）
  cat > .ai/version.yaml <<EOF
# Team Harness 版本锁定（PRD §7.3）
# 升级 Harness 后重新执行 ./harness init 即可刷新 rules/prompts 与版本号。
version: ${HARNESS_VERSION}
profile: ${profile}
javaVersion: ${java_version}
projectName: ${project_name}
EOF
  ok "生成 .ai/version.yaml"

  # 渲染入口文件（受管文件，覆盖）
  local sed_args=(
    -e "s|{{project_name}}|${project_name}|g"
    -e "s|{{project_description}}|${description}|g"
    -e "s|{{profile}}|${profile}|g"
    -e "s|{{java_version}}|${java_version}|g"
    -e "s|{{harness_version}}|${HARNESS_VERSION}|g"
  )
  render_template "CLAUDE.md.tpl" "CLAUDE.md" "${sed_args[@]}"
  ok "生成 CLAUDE.md（Claude Code 入口）"

  say ""
  say "接入完成 ✅"
  say "下一步:"
  say "  1. 编辑 .ai/context/project.md 填写项目背景、技术栈、模块说明"
  say "  2. 运行 ./harness check 自检"
  say "  3. 用 Claude Code 打开本项目，AI 按 .ai/rules/INDEX.md 按需加载规范"
  say "  4. 任务结束往 .ai/log/changes.md 追加一条操作日志"
}

# 本地轻量自检（研发阶段用，非 CI 门禁）
cmd_check() {
  local fails="" cnt=0 d f r n
  say "Team Harness 自检（v${HARNESS_VERSION}）"; say ""

  for d in .ai .ai/rules .ai/context .ai/prompts .ai/log; do
    if [[ -d "$d" ]]; then ok "目录  $d"; else fails+="• 缺失目录: $d"$'\n'; cnt=$((cnt+1)); fi
  done
  for f in .ai/version.yaml .ai/rules/INDEX.md CLAUDE.md; do
    if [[ -f "$f" ]]; then ok "文件  $f"; else fails+="• 缺失文件: $f"$'\n'; cnt=$((cnt+1)); fi
  done
  for r in coding api database exception security test; do
    [[ -f ".ai/rules/$r.md" ]] || { fails+="• 缺失规则: .ai/rules/$r.md"$'\n'; cnt=$((cnt+1)); }
  done
  for r in feature bugfix review unittest document; do
    [[ -f ".ai/prompts/$r.md" ]] || { fails+="• 缺失 Prompt: .ai/prompts/$r.md"$'\n'; cnt=$((cnt+1)); }
  done
  if [[ -d .ai/context ]] && grep -rq "\[CUSTOMIZE" .ai/context 2>/dev/null; then
    n="$(grep -rn "\[CUSTOMIZE" .ai/context 2>/dev/null | wc -l | tr -d ' ')"
    fails+="• .ai/context 有 ${n} 处未填写的 [CUSTOMIZE] 占位"$'\n'; cnt=$((cnt+1))
  else
    ok ".ai/context 无 [CUSTOMIZE] 残留"
  fi

  say ""
  if [[ "$cnt" -eq 0 ]]; then ok "自检通过 ✅（0 个问题）"; return 0; fi
  warn "发现 $cnt 个问题："
  printf '%s' "$fails" | while IFS= read -r line; do [[ -n "$line" ]] && err "$line"; done
  return 1
}

# 打印规则路由表（按任务选读规则，避免整体加载）
cmd_rules() {
  if   [[ -f .ai/rules/INDEX.md ]]; then cat .ai/rules/INDEX.md
  elif [[ -f "$HARNESS_HOME/profiles/springboot/rules/INDEX.md" ]]; then
    cat "$HARNESS_HOME/profiles/springboot/rules/INDEX.md"
  else
    err "未找到规则路由表 INDEX.md（先运行 ./harness init）"; return 1
  fi
}

# AI 操作日志：查看 / 初始化
cmd_log() {
  local do_init=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --init) do_init=1; shift ;;
      -h|--help) say "用法: harness log [--init]  （查看 / 初始化 AI 操作日志）"; return 0 ;;
      *) err "未知参数: $1"; return 1 ;;
    esac
  done

  local log=.ai/log/changes.md
  if [[ "$do_init" -eq 1 ]]; then
    mkdir -p .ai/log
    if [[ ! -f "$log" && -f "$HARNESS_HOME/profiles/springboot/log/changes.md" ]]; then
      cp "$HARNESS_HOME/profiles/springboot/log/changes.md" "$log"; ok "已初始化 $log"
    elif [[ -f "$log" ]]; then warn "$log 已存在，未覆盖"
    else err "日志模板不存在"; return 1; fi
    return 0
  fi

  if [[ -f "$log" ]]; then cat "$log"; else err "未找到 $log（用 harness log --init 初始化）"; return 1; fi
}

# 可选极简 pre-commit：安装 / 卸载
cmd_hooks() {
  local mode=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --install)   mode=install; shift ;;
      --uninstall) mode=uninstall; shift ;;
      -h|--help) say "用法: harness hooks --install | --uninstall"; return 0 ;;
      *) err "未知参数: $1"; return 1 ;;
    esac
  done
  [[ -z "$mode" ]] && { err "请指定 --install 或 --uninstall"; return 1; }

  local git_dir
  git_dir="$(git rev-parse --git-dir 2>/dev/null)" || { err "当前目录不是 git 仓库"; return 1; }
  local hook="$git_dir/hooks/pre-commit"
  local src="$HARNESS_HOME/git-hooks/pre-commit"

  if [[ "$mode" == "install" ]]; then
    [[ -f "$src" ]] || { err "Hook 源不存在: $src"; return 1; }
    mkdir -p "$git_dir/hooks"
    cp "$src" "$hook"; chmod +x "$hook"
    ok "已安装 pre-commit → $hook"
    say "  极简检查：提交前查 .ai/context 的 [CUSTOMIZE] 占位；跳过用 git commit --no-verify"
  else
    if [[ -f "$hook" ]]; then rm -f "$hook"; ok "已卸载 pre-commit"; else warn "未安装 pre-commit，无需卸载"; fi
  fi
}

cmd_version() {
  say "Team Harness CLI v${HARNESS_VERSION}"
  say "仓库: https://github.com/timothyxujun-a11y/team-harness"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    init)                 cmd_init "$@" ;;
    check)                cmd_check "$@" ;;
    rules)                cmd_rules "$@" ;;
    log)                  cmd_log "$@" ;;
    hooks)                cmd_hooks "$@" ;;
    version|--version|-v) cmd_version ;;
    help|--help|-h)       usage ;;
    *) err "未知命令: $cmd"; echo; usage; exit 1 ;;
  esac
}

main "$@"
